{
  "name": "rhdh-dependency-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency health report for Backstage, RHDH and related plugin repositories, published as a GitHub Page.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clone": "node scripts/clone-repos.ts",
    "collect": "node scripts/collect.ts",
    "check": "node scripts/check.ts",
    "report": "npm run clone && npm run collect && npm run check",
    "typecheck": "tsc -p tsconfig.scripts.json && astro check",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
